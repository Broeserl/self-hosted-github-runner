RUNNER_NAME=
RUNNER_URL=
RUNNER_TOKEN=
# Kommagetrennte Labels (Standard: self-hosted,linux,x64).
# Jobs im Projekt adressieren den Runner ueber diese Labels:
#   runs-on: [self-hosted, linux, x64]
RUNNER_LABELS=self-hosted,linux,x64
# Optional: eigener Docker-Container-Name (Default: RUNNER_NAME).
# Muss lowercase sein und darf nur [a-zA-Z0-9_.-] enthalten.
# CONTAINER_NAME=github-runner-1
# Optional: 1 = frischer Zustand pro Job (--ephemeral).
# Nur fuer private Repos noetig/wichtig, siehe README (Security).
RUNNER_EPHEMERAL=
